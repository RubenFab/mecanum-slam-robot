<?xml version="1.0"?>
<!--
  URDF of the Mecanum SLAM robot.

  Frame tree:
    base_footprint (ground projection)
      └── base_link (geometric center of the chassis)
            ├── wheel_front_left_link
            ├── wheel_front_right_link
            ├── wheel_rear_left_link
            ├── wheel_rear_right_link
            ├── laser_frame   (YDLIDAR X2)
            └── imu_link      (MPU-6050 on the Arduino)

  All dimensions are grouped in the properties below.
  The wheels are attached with FIXED joints: they are purely visual (no
  joint_state_publisher needed). If you ever want to see them spin in RViz,
  switch the joints to "continuous" and run joint_state_publisher.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slam_robot">

  <!-- ================= DIMENSIONS TO ADJUST ================= -->

  <!-- Half-wheelbases: distance from the chassis center to the wheel AXIS.
       WHEELBASE_X = front/rear distance, WHEELBASE_Y = left/right
       (chassis center -> wheel center, NOT wheel to wheel). -->
  <xacro:property name="wheelbase_x" value="0.15"/>   <!-- TODO: MEASURE (m) -->
  <xacro:property name="wheelbase_y" value="0.15"/>   <!-- TODO: MEASURE (m) -->

  <!-- Mecanum wheels, 97 mm diameter -->
  <xacro:property name="wheel_radius" value="0.0485"/>
  <xacro:property name="wheel_width"  value="0.040"/>  <!-- TODO: MEASURE (m) -->

  <!-- Chassis (simple box for the visual) -->
  <xacro:property name="chassis_length" value="0.28"/> <!-- TODO: MEASURE (m) -->
  <xacro:property name="chassis_width"  value="0.24"/> <!-- TODO: MEASURE (m) -->
  <xacro:property name="chassis_height" value="0.10"/> <!-- TODO: MEASURE (m) -->
  <!-- Height of the chassis CENTER above the ground -->
  <xacro:property name="chassis_z_offset" value="${wheel_radius + 0.02}"/> <!-- TODO: MEASURE -->

  <!-- LiDAR: position of the optical center relative to base_link.
       The X2 is assumed centered on the chassis (x=0, y=0). -->
  <xacro:property name="lidar_x" value="0.0"/>         <!-- TODO: MEASURE if off-center (m) -->
  <xacro:property name="lidar_y" value="0.0"/>         <!-- TODO: MEASURE if off-center (m) -->
  <!-- Laser plane height RELATIVE TO THE GROUND; subtract the chassis offset -->
  <xacro:property name="lidar_height_from_ground" value="0.20"/> <!-- TODO: MEASURE (m) -->
  <xacro:property name="lidar_z" value="${lidar_height_from_ground - chassis_z_offset}"/>
  <!-- LiDAR rotation about Z if its "front" is not aligned with the robot's
       front (e.g. 3.14159 if it is mounted backwards). -->
  <xacro:property name="lidar_yaw" value="0.0"/>       <!-- TODO: CHECK (rad) -->

  <!-- IMU MPU-6050: position relative to base_link -->
  <xacro:property name="imu_x" value="0.0"/>           <!-- TODO: MEASURE (m) -->
  <xacro:property name="imu_y" value="0.0"/>           <!-- TODO: MEASURE (m) -->
  <xacro:property name="imu_z" value="0.0"/>           <!-- TODO: MEASURE (m) -->

  <!-- ================= COLORS ================= -->
  <material name="gris_chassis"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="noir_roue"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="bleu_lidar"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="rouge_imu"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ================= BASE ================= -->

  <!-- base_footprint: projection of base_link onto the ground (z = 0).
       This is the reference frame used by slam_toolbox and Nav2. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="gris_chassis"/>
    </visual>
  </link>

  <!-- ================= WHEELS ================= -->

  <!-- Wheel macro: cylinder oriented along the Y axis (90 deg rotation about X).
       reflect_x = +1 front / -1 rear ; reflect_y = +1 left / -1 right -->
  <xacro:macro name="roue" params="prefix reflect_x reflect_y">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="noir_roue"/>
      </visual>
    </link>
    <joint name="wheel_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <!-- The wheel sits at its axis level: z brought to the axis height -->
      <origin xyz="${reflect_x * wheelbase_x} ${reflect_y * wheelbase_y} ${wheel_radius - chassis_z_offset}"
              rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:roue prefix="front_left"  reflect_x="1"  reflect_y="1"/>
  <xacro:roue prefix="front_right" reflect_x="1"  reflect_y="-1"/>
  <xacro:roue prefix="rear_left"   reflect_x="-1" reflect_y="1"/>
  <xacro:roue prefix="rear_right"  reflect_x="-1" reflect_y="-1"/>

  <!-- ================= LIDAR ================= -->

  <link name="laser_frame">
    <visual>
      <geometry>
        <!-- Approximation of the YDLIDAR X2 housing -->
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="bleu_lidar"/>
    </visual>
  </link>

  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <!-- ================= IMU ================= -->

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="rouge_imu"/>
    </visual>
  </link>

  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

</robot>
